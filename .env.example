# ─────────────────────────────────────────────────────────────
# HXM LATAM — Variables de entorno (ejemplo)
# Copia este archivo como .env para desarrollo local.
# IMPORTANTE: todas las variables PUBLIC_* terminan en el HTML
# público. Nunca coloques aquí claves secretas ni API keys privadas.
# ─────────────────────────────────────────────────────────────

# URL canónica del sitio (sin diagonal final)
PUBLIC_SITE_URL=https://hxmlatam.com

# Analítica (dejar vacío para desactivar). Solo se cargan con consentimiento.
PUBLIC_GA_ID=
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=

# Endpoints HTTPS de formularios (Formspree, API propia, etc.).
# Si un endpoint específico está vacío se usa PUBLIC_CONTACT_ENDPOINT.
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_INVESTMENT_ENDPOINT=
PUBLIC_PLAYER_ENDPOINT=

# Ubicación del campus
PUBLIC_MAP_URL=https://maps.app.goo.gl/J4WKFbJHaZhM87AH6
